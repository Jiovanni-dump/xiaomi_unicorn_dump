			};

			qupv3_se4_spi_active {
				phandle = <0x2e>;

				mux {
					pins = "gpio16\0gpio17\0gpio18";
					function = "qup4";
				};

				config {
					pins = "gpio16\0gpio17\0gpio18";
					drive-strength = <0x06>;
					bias-disable;
				};
			};

			qupv3_se4_spi_sleep {
				phandle = <0x30>;

				mux {
					pins = "gpio16\0gpio17\0gpio18";
					function = "gpio";
				};

				config {
					pins = "gpio16\0gpio17\0gpio18";
					drive-strength = <0x06>;
					bias-disable;
				};
			};

			msm_gpio_reset {
				phandle = <0x2b>;

				mux {
					pins = "gpio41";
					function = "gpio";
				};

				config {
					pins = "gpio41";
					drive-strength = <0x02>;
					bias-disable;
					output-low;
				};
			};

			msm_gpio_reset_output_high {
				phandle = <0x2c>;

				mux {
					pins = "gpio41";
					function = "gpio";
				};

				config {
					pins = "gpio41";
					drive-strength = <0x02>;
					bias-disable;
					output-high;
				};
			};

			msm_gpio_irq {
				phandle = <0x2d>;

				mux {
					pins = "gpio40";
					function = "gpio";
				};

				config {
					pins = "gpio40";
					drive-strength = <0x02>;
					bias-pull-down;
				};
			};
		};
	};

